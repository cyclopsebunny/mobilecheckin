# Copy this file to .env.local and replace placeholder values.
# Never commit real secrets to git.

OPENAI_API_KEY=your_openai_api_key_here
# gpt-4o is recommended — significantly less hallucination on document fields.
# gpt-4o-mini is cheaper but prone to inventing names/values it cannot read.
OPENAI_MODEL=gpt-4o

# FMCSA QCMobile API — get a free WebKey at https://mobile.fmcsa.dot.gov/
FMCSA_WEBKEY=your_fmcsa_webkey_here

# Shared access code for the hosted prototype. When set, every page and API
# route requires it (one password shared with the team — not real auth).
# Leave unset locally to disable the gate.
SITE_PASSWORD=pick_a_shared_code

# Optional — embeds a keyed Google map on the result screen instead of the
# keyless fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
